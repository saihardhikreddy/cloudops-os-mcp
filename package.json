{
  "name": "cloudops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CloudOps OS",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "docker:build": "docker build -t cloudops-mcp:latest .",
    "docker:run": "docker compose up --build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "@modelcontextprotocol/ext-apps": ">=0.1.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "author": "Antigravity",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
